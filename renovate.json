{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "reviewers": ["team:nunki"],
  "pinDigests": true,
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/.*\\.ya?ml$"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s*CLAMAV_VERSION\\s*[=:]\\s*\"?(?<currentValue>[0-9][\\w.-]*)\"?"
      ],
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["clamav/clamav"],
      "groupName": "clamav"
    },
    {
      "matchPackageNames": ["clamav/clamav"],
      "matchUpdateTypes": ["patch"],
      "labels": ["renovate", "dependency", "bump:patch"]
    },
    {
      "matchPackageNames": ["clamav/clamav"],
      "matchUpdateTypes": ["minor"],
      "labels": ["renovate", "dependency", "bump:minor"]
    },
    {
      "matchPackageNames": ["clamav/clamav"],
      "matchUpdateTypes": ["major"],
      "labels": ["renovate", "dependency", "bump:major"]
    },
    {
      "matchPackageNames": ["clamav/clamav"],
      "matchUpdateTypes": ["digest"],
      "labels": ["renovate", "dependency"]
    },
    {
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    }
  ]
}
